# ==============================================================================
# RoutBuddy Master Environment Template
# ==============================================================================

# --- Database & Cache Configuration ---
POSTGRES_DB=routbuddy_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379

# --- Backend Spring Boot Configuration ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/routbuddy_db
DB_USER=postgres
DB_PASSWORD=postgrespassword

# --- Security & JWT ---
JWT_SECRET=routbuddy_super_secure_jwt_secret_key_minimum_256_bits_for_production_use_2026
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Dynamic Boarding Pass Cryptography ---
QR_SECRET=routbuddy_hmac_sha256_secret_key_for_boarding_tokens_2026
QR_VALIDITY_SECONDS=60

# --- AI Microservice Configuration ---
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000

# --- Frontend Admin Dashboard ---
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_AI_URL=http://localhost:8000
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1Ijoicm91dGJ1ZGR5IiwiYSI6ImNsbXBsZDEyMzAwM3MyanJ5NnhxbmsyYm4ifQ.example_token

# --- Third-Party Integrations (Optional) ---
RAZORPAY_KEY_ID=rzp_test_example
RAZORPAY_KEY_SECRET=rzp_secret_example
TWILIO_ACCOUNT_SID=AC_example
TWILIO_AUTH_TOKEN=auth_token_example
TWILIO_PHONE_NUMBER=+1234567890
