ios/Runner/GeneratedPluginRegistrant.h
ios/Runner/GeneratedPluginRegistrant.m

# --- Databases & Local Storage ---
backend/data/
**/data/*.db
**/data/*.mv.db
**/data/*.trace.db
pgdata/
redisdata/

# --- IDEs & Editors ---
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.sublime-project
*.sublime-workspace
