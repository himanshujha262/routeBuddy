# --- Environment Variables & Secrets ---
.env
.env.*
!.env.example
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# --- Java & Maven ---
target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
.mvn/timing.properties

# --- Python & FastAPI ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# --- Node.js & Next.js ---
node_modules/
**/node_modules/
.pnp
.pnp.js
coverage/
.next/
**/out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Flutter & Dart ---
.dart_tool/
**/.dart_tool/
build/
**/build/
**/build_old_*/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
**/ephemeral/
android/.gradle
android/captures/
android/gradlew
android/gradlew.bat
android/local.properties
android/GeneratedPluginRegistrant.java
ios/.symlinks/
ios/Pods/
