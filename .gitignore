Thumbs.db
Desktop.ini

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Terraform ---
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# --- Local Tools & Scratch ---
tools/
**/tools/
.FullName
